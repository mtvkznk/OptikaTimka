# Copy outside the repository to C:/Deploy/OptikaTimka/prod.env.
# Replace every placeholder. Generate separate secrets with secrets.token_hex(32).
APP_NAME="Optika Timka"
ENVIRONMENT=production
PUBLIC_BASE_URL="https://YOUR-DOMAIN.example"
AUTH_SECRET=""
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
# Set with the Google OAuth credentials to disable password login for the admin dashboard.
ADMIN_GOOGLE_EMAIL=""
PHONE_AUTH_DEBUG=false
POSTGRES_PASSWORD=""
# Use the same PostgreSQL password above; URL-encode it if it has reserved characters.
DATABASE_URL="postgresql+psycopg://optika_timka:REPLACE_PASSWORD@db:5432/optika_timka"
# Exact trusted reverse-proxy IPs/CIDRs; do not trust forwarded headers from everyone.
FORWARDED_ALLOW_IPS="127.0.0.1"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
